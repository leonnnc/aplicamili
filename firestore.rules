rules_version = '2';

// LavaMili · Reglas de Firestore
// Pegar en: Consola de Firebase → Firestore Database → Reglas → Publicar
//
// Modelo de datos:
//   negocios/{negocioId}/ordenes/{ordenId}
//   negocios/{negocioId}/clientes/{clienteId}
//   negocios/{negocioId}/ajustes/precios
//   negocios/{negocioId}/usuarios/{uid}   (nombre, rol, correo)

service cloud.firestore {
  match /databases/{database}/documents {

    match /negocios/{negocioId} {

      // Solo entra quien tiene ficha de operador en este negocio.
      function esMiembro() {
        return request.auth != null
          && exists(/databases/$(database)/documents/negocios/$(negocioId)/usuarios/$(request.auth.uid));
      }

      function rol() {
        return get(/databases/$(database)/documents/negocios/$(negocioId)/usuarios/$(request.auth.uid)).data.rol;
      }

      // Perfil del operador: cada uno lee el suyo. Se crea solo la primera vez,
      // siempre como "Operador". Los ascensos se hacen desde la consola.
      match /usuarios/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow list: if false;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.rol == 'Operador'
          && request.resource.data.correo == request.auth.token.email;
        allow update, delete: if false;
      }

      match /ordenes/{ordenId} {
        allow read, write: if esMiembro();
      }

      match /clientes/{clienteId} {
        allow read, write: if esMiembro();
      }

      // Ajustes del negocio:
      //   ajustes/precios       → { mapa: { idServicio: tarifa } }
      //   ajustes/autorizacion  → { datos: { codigo, autor, creada, expira } }
      //   ajustes/solicitudes   → { datos: [ pedidos de cambio ] }
      //   ajustes/auditoria     → { datos: [ cambios de tarifa ] }
      //
      // Escribe cualquier miembro porque el código de urgencia lo valida la
      // aplicación: el mostrador publica el cambio ya autorizado. Para candar
      // los precios en el servidor haría falta una Cloud Function que valide
      // el código; una regla sola también bloquearía el desbloqueo de urgencia.
      match /ajustes/{docId} {
        allow read, write: if esMiembro();
      }
    }
  }
}
